# ── App ──────────────────────────────────────────
APP_NAME=나의 일기(내일) API
APP_VERSION=0.1.0
APP_ENV=local

# ── Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nailgi
DB_USER=nailgi
DB_PASSWORD=your_password_here

DATABASE_URL=postgresql://nailgi:your_password_here@localhost:5432/nailgi

# ── JWT ───────────────────────────────────────────
JWT_SECRET_KEY=your-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── pgAdmin ───────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ── AWS S3 (MVP 이후 설정) ──────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2
